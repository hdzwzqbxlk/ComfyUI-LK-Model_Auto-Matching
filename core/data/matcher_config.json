{
  "db": {
    "enabled": true,
    "exact_score": 1.0,
    "basename_score": 0.99,
    "semantic_min_score": 0.35,
    "fuzzy_score_cutoff": 80,
    "civitai_score": 0.99
  },
  "matching": {
    "use_db_fallback": true,
    "core_coverage_min": 0.6,
    "core_min_tokens": 2,
    "use_exact_match": true,
    "use_fuzzy_match": true,
    "use_variant_match": true,
    "use_legacy_match": true,
    "fuzzy_score_cutoff": 65.0,
    "variant_score_cutoff": 0.9,
    "legacy_score_cutoff": 80
  },
  "searcher": {
    "network": {
      "timeout": 20,
      "impersonate": "chrome124"
    },
    "cache_ttl": 300,
    "early_stop_score": 0.7,
    "high_confidence_score": 0.9,
    "db_fallback_score": 0.85,
    "search_term_limit": 5,
    "source_preference": {
      "HuggingFace": 1.0,
      "ModelScope": 1.0,
      "CNB": 0.95,
      "Civitai": 0.9,
      "Liblib": 0.9
    },
    "namespace_preference": {
      "Comfy-Org": 1.15,
      "unsloth": 1.08
    },
    "priority_organizations": {
      "huggingface": ["Comfy-Org", "unsloth"],
      "modelscope": ["Comfy-Org", "unsloth"]
    },
    "api": {
      "civitai": {
        "url": "https://civitai.com/api/v1/model-versions/by-hash",
        "limit": 20
      },
      "huggingface": {
        "limit": 8,
        "hash_scores": {
          "exact": 0.98,
          "dir": 0.95,
          "file": 0.92
        }
      },
      "liblib": {
        "limit": 8
      }
    },
    "providers": {
      "modelscope": {
        "timeout": 25
      },
      "huggingface": {
        "scan_dirs": []
      }
    }
  },
  "features": {
    "chinese_tokenization": true,
    "version_aware": true
  }
}
